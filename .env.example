# .env.example — Copy to .env and fill in your real values.
# Never commit your actual .env file to source control!

# ── Neo4j Aura ──────────────────────────────────────────────────────────────
# Get these from your Neo4j Aura console (console.neo4j.io)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-generated-password

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Graphiti uses OpenAI to embed text and extract graph entities
OPENAI_API_KEY=sk-...

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-long-random-string
